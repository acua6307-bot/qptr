     "output_type": "stream",
     "text": [
      "E_1 (eV) = -13.6\n"
     ]
    }
   ],
   "source": [
    "n_max = 4\n",
    "Z = 1\n",
    "\n",
    "n = np.arange(1, n_max+1)\n",
    "\n",
    "En_eV = -13.6*Z**2/n**2\n",
    "En_J = En_eV * eC\n",
    "\n",
    "print(\"E_1 (eV) =\", En_eV[0])"
   ]
